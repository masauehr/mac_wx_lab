&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '@START_WPS@',
 end_date   = '@END_WPS@',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 121,
 e_sn              = 101,
 geog_data_res     = 'lowres',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   = 26.0,
 ref_lon   = 127.5,
 truelat1  = 26.0,
 truelat2  = 26.0,
 stand_lon = 127.5,
 geog_data_path = '../../../data/geog_dl/WPS_GEOG_LOW_RES',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/

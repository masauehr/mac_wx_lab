&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '@START_WPS@', '@START_WPS@',
 end_date   = '@END_WPS@', '@END_WPS@',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, @IPS@,
 j_parent_start    = 1, @JPS@,
 e_we              = 121, @NE@,
 e_sn              = 101, @NE@,
 geog_data_res     = 'lowres', 'default',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   = 26.0,
 ref_lon   = 127.5,
 truelat1  = 26.0,
 truelat2  = 26.0,
 stand_lon = 127.5,
 geog_data_path = '../../../data/geog_dl/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
